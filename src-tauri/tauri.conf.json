{
	"$schema": "https://schema.tauri.app/config/2",
	"bundle": {
		"active": true,
		"targets": "all",
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": "",
			"nsis": {
				"languages": ["Russian"]
			},
			"wix": {
				"language": "ru-RU"
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": [],
		"externalBin": [],
		"copyright": "",
		"category": "Utility",
		"shortDescription": "Приложение для скачивания альбомов фотографий из Вконтакте",
		"longDescription": "Приложение для скачивания альбомов фотографий из Вконтакте",
		"macOS": {},
		"linux": {
			"deb": {}
		}
	},
	"build": {
		"beforeBuildCommand": "pnpm generate",
		"frontendDist": "../dist",
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:3000"
	},
	"productName": "VKAlbum",
	"version": "2.1.2",
	"identifier": "com.mlpoffff.vkalbum",
	"plugins": {},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "VKAlbum",
				"width": 1366,
				"height": 768,
				"visible": false,
				"minWidth": 375,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	}
}
