{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main",
	"description": "Capabilities shared by every platform",
	"windows": [
		"main",
		"secondary"
	],
	"permissions": [
		"core:default",
		"core:webview:allow-create-webview-window",
		"shell:allow-open",
		"opener:default",
		"dialog:default",
		"notification:default",
		"os:default",
		"fs:allow-document-read",
		"fs:allow-document-write",
		"store:default"
	]
}
